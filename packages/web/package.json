{
  "name": "@seedexr/zuri",
  "version": "0.1.1",
  "description": "Zuri web runtime, an open alternative to Rive: play interactive vector animations (state machines, data binding) in the browser. From 81 KB of WebAssembly (brotli), no dependencies.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/SeedeXR/zuri.git", "directory": "packages/web" },
  "homepage": "https://github.com/SeedeXR/zuri#readme",
  "bugs": "https://github.com/SeedeXR/zuri/issues",
  "keywords": ["zuri", "animation", "vector", "vector-graphics", "interactive", "state-machine", "data-binding", "motion", "ui-animation", "canvas", "wasm", "webassembly", "web-component", "player", "rive"],
  "type": "module",
  "sideEffects": ["./dist/element.js"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./element": { "types": "./dist/element.d.ts", "default": "./dist/element.js" },
    "./zuri.wasm": "./dist/zuri.wasm",
    "./zuri-lite.wasm": "./dist/zuri-lite.wasm",
    "./zuri-editor.wasm": "./dist/zuri-editor.wasm"
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "tsc -p test/tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
