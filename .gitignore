# Build outputs (all reproducible: see scripts/verify.sh)
target/
node_modules/
dist/
examples/dist/
*.tsbuildinfo

# Knowledge graph (regenerated by `graphify update .` and the post-commit hook)
graphify-out/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Engines
integrations/unity/**/Library/
integrations/unity/**/Temp/
integrations/unity/**/obj/
integrations/unity/**/bin/
integrations/unreal/**/Binaries/
integrations/unreal/**/Intermediate/
# The Unity native libraries and their metas are put there by scripts/build-unity-plugins.sh
# (the metas come from integrations/unity/PluginMeta~/).
integrations/unity/Plugins/*
!integrations/unity/Plugins/.gitkeep

# Source reports (PDFs). Kept local until the owner decides whether they go public.
research/
