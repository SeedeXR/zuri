{
  "zuri": 1,
  "children": [
    {
      "type": "Artboard", "name": "Keys", "width": 10, "height": 10,
      "children": [
        { "type": "ViewModel", "name": "vm", "children": [
          { "type": "Property", "name": "downs", "valueType": "number", "value": 0 },
          { "type": "Property", "name": "ups", "valueType": "number", "value": 0 }
        ] },
        { "type": "StateMachine", "name": "Keys", "children": [
          { "type": "Listener", "event": "keyDown", "key": "a", "input": "downs", "action": "add", "value": 1 },
          { "type": "Listener", "event": "keyUp", "key": "a", "input": "ups", "action": "add", "value": 1 },
          { "type": "Listener", "event": "keyDown", "key": " ", "input": "downs", "action": "add", "value": 10 },
          { "type": "Listener", "event": "keyUp", "key": "Escape", "input": "ups", "action": "add", "value": 10 }
        ] }
      ]
    }
  ]
}
