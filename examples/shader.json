{
  "zuri": 1,
  "children": [
    {
      "type": "ShaderAsset", "name": "plasma",
      "wgsl": "fn shade(uv: vec2f) -> vec4f {\n    let t = zuri.time * zuri.params.x;\n    let p = (uv - 0.5) * 6.0;\n    let v = sin(p.x + t) + sin(p.y * 1.3 - t * 0.7) + sin(length(p) * 1.6 - t * 1.3);\n    let c = 0.5 + 0.5 * cos(vec3f(0.0, 2.1, 4.2) + v * 1.2 + zuri.params.y);\n    return vec4f(c, 1.0);\n}\n"
    },
    {
      "type": "Artboard", "name": "Shader", "width": 400, "height": 240,
      "children": [
        { "type": "Fill", "color": "#0e1016" },
        { "type": "ViewModel", "name": "vm", "children": [
          { "type": "Property", "name": "hue", "valueType": "number", "value": 0 } ] },
        { "type": "Shape", "name": "card", "x": 200, "y": 120, "children": [
          { "type": "Rectangle", "width": 320, "height": 160, "radius": 28 },
          { "type": "Fill", "color": "#5b3df5", "children": [
            { "type": "ShaderPaint", "name": "paint", "asset": "plasma", "p0": 1, "children": [
              { "type": "Bind", "source": "hue", "property": "p1" } ] } ] },
          { "type": "Stroke", "color": "#ffffff40", "thickness": 2 } ] },
        { "type": "Shape", "name": "dot", "x": 200, "y": 120, "children": [
          { "type": "Ellipse", "width": 46, "height": 46 },
          { "type": "Fill", "color": "#ffffff" } ] },
        { "type": "Animation", "name": "pulse", "fps": 60, "duration": 90, "loop": "pingpong", "children": [
          { "type": "Track", "target": "dot", "property": "scaleX", "children": [
            { "type": "Key", "frame": 0, "value": 0.7, "interp": "cubic" }, { "type": "Key", "frame": 90, "value": 1.2 } ] },
          { "type": "Track", "target": "dot", "property": "scaleY", "children": [
            { "type": "Key", "frame": 0, "value": 0.7, "interp": "cubic" }, { "type": "Key", "frame": 90, "value": 1.2 } ] } ] }
      ]
    }
  ]
}
