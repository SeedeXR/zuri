        { "type": "Shape", "name": "target", "children": [
          { "type": "Constraint", "name": "ride", "constrain": "followPath", "target": "orbit", "orient": false },
          { "type": "Ellipse", "width": 14, "height": 14 },
          { "type": "Fill", "color": "#ffd27a" } ] },

        { "type": "Shape", "name": "base", "x": 70, "y": 200, "children": [
          { "type": "Rectangle", "width": 60, "height": 14, "radius": 7 },
          { "type": "Fill", "color": "#2a2e3d" } ] },
        { "type": "Bone", "name": "upper", "x": 70, "y": 196, "rotation": -100, "length": 90, "children": [
          { "type": "Shape", "x": 45, "children": [
            { "type": "Rectangle", "width": 104, "height": 16, "radius": 8 },
            { "type": "Fill", "color": "#4f7cff" } ] },
          { "type": "Bone", "name": "fore", "rotation": 70, "length": 80, "children": [
            { "type": "Constraint", "constrain": "ik", "target": "target", "bones": 2 },
            { "type": "Shape", "x": 40, "children": [
              { "type": "Rectangle", "width": 92, "height": 12, "radius": 6 },
              { "type": "Fill", "color": "#7ea0ff" } ] },
