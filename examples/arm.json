            { "type": "Fill", "color": "#14161f" },
            { "type": "Stroke", "color": "#7ea0ff", "thickness": 3 } ] } ] },

        { "type": "Animation", "name": "circle", "fps": 60, "duration": 240, "loop": "loop", "children": [
